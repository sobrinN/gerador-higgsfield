# Higgsfield API Credentials (format: key-id:key-secret)
# Paste the complete key copied from https://open.higgsfield.ai/api-keys as-is.
# The Rust server & CLI automatically load HF_API_KEY, HF_CREDENTIALS, or HF_KEY from .env.local or .env.
HF_API_KEY=
HF_CREDENTIALS=
HF_KEY=

# Optional server configuration
HF_API_BASE_URL=https://api.higgsfield.ai
PORT=3000
